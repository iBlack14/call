<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_main_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="2dp"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/brandBadge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_company_image"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VC"
                    android:textColor="@color/vc_text_inverse"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/heroKickerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE BRIDGE"
                    android:textAllCaps="true"
                    android:textColor="@color/vc_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="VOIP VC"
                    android:textColor="@color/vc_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Marcador profesional para el bridge Android"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/onboardingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_main_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vincula este equipo"
                android:textColor="@color/vc_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Escanea el QR del dashboard o usa el enlace técnico manual si lo necesitas."
                android:textColor="@color/vc_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_accent_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flujo recomendado"
                    android:textColor="@color/vc_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1. Escanea el QR&#10;2. La APK se vincula sola&#10;3. El bridge queda listo para recibir llamadas"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanQrBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Escanear QR"
                    android:textAllCaps="false"
                    android:textColor="@color/vc_text_inverse"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/vc_text_inverse" />
            </LinearLayout>

            <TextView
                android:id="@+id/manualSetupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ajustes manuales"
                android:textColor="@color/vc_text_primary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/baseUrlLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Servidor"
                app:boxBackgroundColor="@color/vc_surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/vc_border"
                app:hintTextColor="@color/vc_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/baseUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="https://llamada.viacomunicativa.com"
                    android:inputType="textUri"
                    android:textColor="@color/vc_text_primary"
                    android:textColorHint="@color/vc_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/codeLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Código"
                app:boxBackgroundColor="@color/vc_surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/vc_border"
                app:hintTextColor="@color/vc_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="CODE"
                    android:inputType="text"
                    android:textColor="@color/vc_text_primary"
                    android:textColorHint="@color/vc_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tokenLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Token"
                app:boxBackgroundColor="@color/vc_surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/vc_border"
                app:hintTextColor="@color/vc_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="TOKEN"
                    android:inputType="text"
                    android:textColor="@color/vc_text_primary"
                    android:textColorHint="@color/vc_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dark_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Vincular equipo"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse" />

            <TextView
                android:id="@+id/onboardingStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_secondary_card"
                android:padding="14dp"
                android:text="Escanea el QR o completa el enlace manual."
                android:textColor="@color/vc_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/connectedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_main_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Marcador activo"
                        android:textColor="@color/vc_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/connectionBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:text="Activo"
                        android:textColor="@color/vc_success"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/persistentStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bridge listo para recibir órdenes."
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dispositivo"
                            android:textColor="@color/vc_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/deviceNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-"
                            android:textColor="@color/vc_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sesión"
                            android:textColor="@color/vc_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/sessionValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-"
                            android:textColor="@color/vc_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/serverValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Servidor -"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/permMicChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_state_chip"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:text="Mic"
                        android:textColor="@color/vc_text_secondary" />

                    <TextView
                        android:id="@+id/permNotifChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_state_chip"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:text="Notif"
                        android:textColor="@color/vc_text_secondary" />

                    <TextView
                        android:id="@+id/permDialerChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_state_chip"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:text="Dialer"
                        android:textColor="@color/vc_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_accent_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/currentCallLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin llamada activa"
                    android:textColor="@color/vc_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentCallNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bridge listo"
                    android:textColor="@color/vc_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentCallNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="-"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/callStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_state_chip"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:text="LISTO"
                        android:textColor="@color/vc_text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/callTimerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="00:00"
                        android:textColor="@color/vc_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/answerBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_success_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Contestar"
                        android:textAllCaps="false"
                        android:textColor="@color/vc_text_inverse"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hangupBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_danger_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Colgar"
                        android:textAllCaps="false"
                        android:textColor="@color/vc_text_inverse" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/muteBtn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Micrófono"
                        android:textAllCaps="false"
                        android:textColor="@color/vc_text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/speakerBtn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Altavoz"
                        android:textAllCaps="false"
                        android:textColor="@color/vc_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/transientStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary_card"
                android:padding="16dp"
                android:text="Esperando actividad del bridge."
                android:textColor="@color/vc_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acciones rápidas"
                    android:textColor="@color/vc_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reconnectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_dark_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Reconectar bridge"
                    android:textAllCaps="false"
                    android:textColor="@color/vc_text_inverse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/relinkBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_secondary_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Revincular / escanear nuevo QR"
                    android:textAllCaps="false"
                    android:textColor="@color/vc_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggleSettingsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_secondary_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Ver ajustes del bridge"
                    android:textAllCaps="false"
                    android:textColor="@color/vc_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_danger_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Cerrar sesión"
                    android:textAllCaps="false"
                    android:textColor="@color/vc_text_inverse" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajustes del bridge"
                    android:textColor="@color/vc_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Solo usa estos campos si necesitas cambiar servidor o reconfigurar manualmente."
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Servidor"
                    app:boxBackgroundColor="@color/vc_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/vc_border"
                    app:hintTextColor="@color/vc_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsBaseUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://llamada.viacomunicativa.com"
                        android:inputType="textUri"
                        android:textColor="@color/vc_text_primary"
                        android:textColorHint="@color/vc_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Código"
                    app:boxBackgroundColor="@color/vc_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/vc_border"
                    app:hintTextColor="@color/vc_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="CODE"
                        android:inputType="text"
                        android:textColor="@color/vc_text_primary"
                        android:textColorHint="@color/vc_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Token"
                    app:boxBackgroundColor="@color/vc_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/vc_border"
                    app:hintTextColor="@color/vc_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsTokenInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TOKEN"
                        android:inputType="text"
                        android:textColor="@color/vc_text_primary"
                        android:textColorHint="@color/vc_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveSettingsPairBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
