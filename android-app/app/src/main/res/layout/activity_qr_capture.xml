<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/qrScannerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B309090B"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VINCULAR DISPOSITIVO"
            android:textColor="@color/vc_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Escanea el QR del dashboard"
            android:textColor="@color/vc_text_inverse"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qrScannerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Centra el código y mantén el teléfono estable."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D909090B"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca la imagen si el código se ve borroso"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qrFocusBtn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Enfocar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse"
                app:backgroundTint="#FF27272A"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_focus"
                app:iconTint="@color/vc_text_inverse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qrTorchBtn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Linterna"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse"
                app:backgroundTint="#FF27272A"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_flashlight"
                app:iconTint="@color/vc_text_inverse" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
